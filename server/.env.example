# 比邻AI · agent 服务环境变量样例
#
# 用法：复制成 server/.env 再填值。.env 已在 .gitignore 里，**密钥永远不进仓库**。
#     copy .env.example .env        (Windows)
#     cp .env.example .env          (Linux / macOS)
#
# 环境变量优先于本文件：容器/计划任务注入的同名变量会覆盖这里的值。

# ── 模型 ────────────────────────────────────────────────────────────────
# auto         有 LLM_API_KEY 就用真模型，没有就用假模型（端侧照样能跑通链路）
# openai_compat 强制走 OpenAI 兼容接口
# fake          强制假模型
LLM_PROVIDER=auto

# OpenAI 兼容的 base_url（到 /v1 为止，不要带 /chat/completions）。
# DeepSeek     https://api.deepseek.com/v1
# 通义千问      https://dashscope.aliyuncs.com/compatible-mode/v1
# Kimi         https://api.moonshot.cn/v1
# 智谱 GLM     https://open.bigmodel.cn/api/paas/v4
# 本地 vLLM    http://127.0.0.1:8000/v1
# 本地 Ollama  http://127.0.0.1:11434/v1
LLM_BASE_URL=https://api.deepseek.com/v1

# ⚠️ 只填在这里，不要写进任何会被提交的文件
LLM_API_KEY=

LLM_MODEL=deepseek-chat
LLM_TIMEOUT=30
LLM_TEMPERATURE=0.8
# 闲聊 1–2 句、说明类 ≤4 句，300 token 足够；调大反而更容易跑成"客服腔长篇"
LLM_MAX_TOKENS=300

# 送进模型的历史消息条数上限（P2 接三层记忆后由相关性检索替代）
CHAT_HISTORY_TURNS=8

# ── 落库（P2 三层记忆）──────────────────────────────────────────────────
# memory://                 不落库，进程重启即清空（**默认**：测试与 CI 必须互不污染）
# sqlite:///data/bilin.db   标准库 sqlite3，零安装、单文件、写入即持久（本机/小规模推荐）
# postgresql://user:pass@host:5432/bilin   需先装驱动：pip install "psycopg[binary]"
#
# 相对路径按 server/ 解析（即 server/data/bilin.db）；启动日志与 /healthz 的
# storage / storageDurable 字段会明确告诉你当前到底落没落库
DATABASE_URL=memory://

# ── 人设 ────────────────────────────────────────────────────────────────
# p_son 儿子小明 / p_daughter 女儿小丽 / p_spouse 老伴老张 / p_friend 老友李姐
DEFAULT_PERSONA_ID=p_son

# ── 提醒调度（P1）──────────────────────────────────────────────────────
# 调度器开关：关掉后不再自动投递提醒（联调做时间旅行时会用到）
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=30
# 允许 POST /v1/scheduler/tick 手动推进（联调/演示用）。⚠️ 上线前改成 false
SCHEDULER_MANUAL_TICK=true
# 过期宽限：服务没运行时错过的提醒，超过这么久就不再补发（免得下午补发早上的用药提醒）
REMINDER_GRACE_MINUTES=30
# 强提醒未响应多久后再响一次，以及最多重复几次
REMINDER_REPEAT_MINUTES=5
REMINDER_MAX_REPEATS=1
# 未响应多久判定为错过
REMINDER_MISS_MINUTES=60
# 弱提醒时间窗（超窗不顺延）
WEAK_REMINDER_START=09:00
WEAK_REMINDER_END=20:00

# ── uni-push 2.0（可选：老人不开 App 也能收到系统通知）──────────────────
# ⚠️ uni-push 2.0 的服务端 SDK 只能跑在 uniCloud 云函数里，所以这里填的是"云函数 URL"。
#    部署步骤见 server/deploy/unipush-cloudfunction/README.md
#    个推的 appkey/mastersecret 留在云函数那侧，不要填到这里
UNIPUSH_SEND_URL=
# 与云函数里的 TOKEN 保持一致（两边都不填 = 谁拿到 URL 谁就能发推送）
UNIPUSH_TOKEN=
UNIPUSH_TIMEOUT=10
# 在线时也创建通知栏消息：提醒类消息要"一定响"
UNIPUSH_FORCE_NOTIFICATION=true

# ── HTTP ───────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
# 开发期允许跨域（HBuilderX 的 H5 预览跑在另一个端口）；上线前收紧成具体域名
CORS_ORIGINS=*
LOG_LEVEL=info

# ── 接口鉴权 ───────────────────────────────────────────────────────────
# off      完全不校验（本机开发）
# auto     配了 API_TOKENS 就强制校验，没配则放行 + 启动日志大声警告（默认）
# required 强制校验；没配 token 直接启动失败 ← **上线用这个**
AUTH_MODE=auto
# 访问 token，逗号分隔（一机一 token，撤销就删掉对应那一串）
# 用足够长的随机串，例如 32 位 hex；端侧用 setApiToken() 配上
API_TOKENS=

# ── 语音（CosyVoice 2 + 字级对齐；**不配则口型走估算版，对话不受影响**）──
# 三选一：
#   1) 独立推理节点（选型文档说的"独立推理节点"）：填 URL，POST {text,voice} 返回 audio/wav
# BILIN_TTS_URL=http://127.0.0.1:9100/tts
#   2) 本机命令行推理（GPU 机器上跑自建脚本）：
# BILIN_TTS_CMD=python D:\CosyVoice\tts_cli.py --text-file {text} --out {out} --voice {voice}
#   3) 都不配 → NullTtsProvider（明确降级，口型 estimated）
# 字级强制对齐（WhisperX / MFA）。输出需为 {"word_segments":[{word,start,end},...]}
# BILIN_ALIGN_CMD=python D:\tools\align_cli.py --audio {audio} --text {text} --out {json}

# ── 语音路线二：阿里云百炼 Qwen-Audio-TTS（托管，**自带字级时间戳**）──
# 选它的理由：本机零安装，且原生给字级时间戳（连"再跑一遍强制对齐"都省了）。
# 代价：音频出网 + 按字计费（与"自建 GPU 推理"取向不同，属产品取舍）。
# 前置：
#   1) pip install dashscope        （**故意不写进 requirements.txt**：仓库只装 4 个包，
#                                     没装时明确降级为估算版口型，不会让服务起不来）
#   2) 配 DASHSCOPE_API_KEY
# 然后打开这一行：
# BILIN_TTS_PROVIDER=qwen
# 模型与音色（默认值就是文档示例；字级时间戳**只对部分音色可用**，换音色后要复验）
# BILIN_TTS_MODEL=qwen-audio-3.0-tts-plus
# BILIN_TTS_VOICE=longanlufeng
# 工作区专属域名（文档推荐；不配则用 SDK 默认的北京端点）
# BILIN_DASHSCOPE_WS_URL=wss://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/api-ws/v1/inference
# 注意：`word_timestamp_enabled` 仅在**流式输出模式**可用（本 Provider 已按流式实现）

# 识图模型（读医院单据照片）。与 TTS 共用 DASHSCOPE_API_KEY。
# 不要用 -latest 别名：工作区专属 key 会 403。
BILIN_VISION_MODEL=qwen-vl-max
