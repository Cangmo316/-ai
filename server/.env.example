# 比邻AI · agent 服务环境变量样例
#
# 用法：复制成 server/.env 再填值。.env 已在 .gitignore 里，**密钥永远不进仓库**。
#     copy .env.example .env        (Windows)
#     cp .env.example .env          (Linux / macOS)
#
# 环境变量优先于本文件：容器/计划任务注入的同名变量会覆盖这里的值。

# ── 模型 ────────────────────────────────────────────────────────────────
# auto         有 LLM_API_KEY 就用真模型，没有就用假模型（端侧照样能跑通链路）
# openai_compat 强制走 OpenAI 兼容接口
# fake          强制假模型
LLM_PROVIDER=auto

# OpenAI 兼容的 base_url（到 /v1 为止，不要带 /chat/completions）。
# DeepSeek     https://api.deepseek.com/v1
# 通义千问      https://dashscope.aliyuncs.com/compatible-mode/v1
# Kimi         https://api.moonshot.cn/v1
# 智谱 GLM     https://open.bigmodel.cn/api/paas/v4
# 本地 vLLM    http://127.0.0.1:8000/v1
# 本地 Ollama  http://127.0.0.1:11434/v1
LLM_BASE_URL=https://api.deepseek.com/v1

# ⚠️ 只填在这里，不要写进任何会被提交的文件
LLM_API_KEY=

LLM_MODEL=deepseek-chat
LLM_TIMEOUT=30
LLM_TEMPERATURE=0.8
# 闲聊 1–2 句、说明类 ≤4 句，300 token 足够；调大反而更容易跑成"客服腔长篇"
LLM_MAX_TOKENS=300

# 送进模型的历史消息条数上限（P2 接三层记忆后由相关性检索替代）
CHAT_HISTORY_TURNS=8

# ── 人设 ────────────────────────────────────────────────────────────────
# p_son 儿子小明 / p_daughter 女儿小丽 / p_spouse 老伴老张 / p_friend 老友李姐
DEFAULT_PERSONA_ID=p_son

# ── HTTP ───────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
# 开发期允许跨域（HBuilderX 的 H5 预览跑在另一个端口）；上线前收紧成具体域名
CORS_ORIGINS=*
LOG_LEVEL=info
