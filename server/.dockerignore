# 不要把本地开发产物塞进镜像
#
# .venv 尤其重要：Windows 的 venv 是 .exe + dll，拷进 Linux 容器只会
# 让镜像大几百 MB 且完全不可用。
.venv/
venv/
__pycache__/
*.pyc
*.pyo

# 运行数据单独挂卷（见 docker-compose.yml），不进镜像
data/
case_files/
_voice_samples/
*.db
*.db-wal
*.db-shm

# 密钥绝不进镜像层（镜像层即使删了也能被 history 捞出来）
.env
.env.*
!.env.example

# 测试与工具，运行期不需要
tests/
docs/
deploy/

# 其它
.git/
.gitignore
*.md
*.log
