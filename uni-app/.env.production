# 打包时的后端地址（部署用）
#
# 这个文件由 Vite 在构建时读取，注入到 api/config.js 的 getBaseURL()。
# 好处：**换服务器只改这一行、重新打包，不用动任何源码**。
#
# ⚠️ 这一行必须顶格、前面不能有 #，否则 Vite 读不到，
#    打包出来的 App 会回落到 127.0.0.1:8000（手机上那是手机自己，必然连不上）。
#
# ⚠️ 也**不能留占位符**。之前这里写的是 https://api.example.com，
#    那是个不存在的域名，打出来的 APK 怎么都连不上（实际踩过）。
#
# ─────────────────────────────────────────────────────────────
# 当前阶段：阿里云 ECS（杭州 / 2核2G / Ubuntu 24.04）
#
# 用公网 IP 是为了**先能用**：手机在任何网络下都能连，不再被 WiFi 地址绑死。
# 拿到域名并配好 HTTPS 后，改成 https://api.你的域名，
# 即可同时满足微信小程序的「必须 HTTPS + 已备案」要求。
# ─────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://121.196.160.179:8000

# 接口级 token（服务端 AUTH_MODE=required 时必填）。
# **故意留空**：仓库是公开的，真实 token 绝不能提交（提交即作废）。
# 构建前把真实值写进 **uni-app/.env.production.local**（已被 .gitignore 忽略）：
#   VITE_API_TOKEN=<服务端 /etc/bilin/bilin.env 里的 API_TOKENS>
#
# ⚠️ 必须用 .env.production.local，不能用 .env.local ——
#    实测 uni 的构建链在打包时**不读** .env.local，token 会静默丢失，
#    表现是打出来的包所有接口 401。.env.[mode].local 才是 Vite 认的。
VITE_API_TOKEN=

# 正式部署时改成：
#   VITE_API_BASE_URL=https://api.你的域名
# 改成 https 之后，manifest 里的 usesCleartextTraffic 可以关掉。
