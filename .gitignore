# ===== 系统 / 编辑器 =====
Thumbs.db
Desktop.ini
.DS_Store
.idea/
.vscode/

# ===== 后端服务（server/）：Python 运行时产物 =====
server/**/__pycache__/
server/**/*.py[cod]
server/**/.venv/
server/**/venv/
server/**/*.egg-info/
server/**/.pytest_cache/
server/**/.mypy_cache/
server/**/.ruff_cache/
server/.env
server/.env.*
!server/.env.example

# ===== 落库产物（P2 三层记忆默认走 sqlite，见 server/.env.example）=====
# 数据库是**运行时数据**，不是源码：含老人的经历与偏好，绝不进仓库
server/data/
*.sqlite
*.sqlite3
*.db-wal
*.db-shm

# ===== 模型权重与大数据文件（CosyVoice 2 / WhisperX 等，不进仓库）=====
# 需要提交的少量测试样本请用 git add -f 强制加入
server/models/
server/**/weights/
server/**/*.safetensors
server/**/*.gguf
server/**/*.onnx
server/**/*.ckpt
server/**/*.pt
server/**/*.bin

# ===== 3D 资产（R45）：只入库精简 .glb + 1K 贴图；忽略 .blend 与全尺寸纹理 =====
# 3D建模/ 全量约 212 MB（.blend ≈ 80 MB + 全尺寸贴图 ≈ 25 MB），SSH over 443 推不动。
# 入库：7 件 .glb（合计 54.1 MB，内嵌 1K）+ textures/1k/ + 文档 / 预览。若仍嫌大，可改走 Git LFS：
#   git lfs track "*.glb"  （需先 git lfs install）
3D建模/**/*.blend
3D建模/**/*.blend1
3D建模/**/textures/*.png
# 资产修复前的备份（276MB）：只是本地保险，不进仓库
3D建模/_backup_*/
